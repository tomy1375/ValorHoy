---
import Layout from '../../layouts/Layout.astro';
import PriceChart from '../../components/PriceChart.astro';
import { Icon } from 'astro-icon/components';

// Esta función es necesaria para rutas dinámicas en modo estático
export function getStaticPaths() {
  // Definir las criptomonedas disponibles dentro de getStaticPaths
  const cryptoTypes = {
    'bitcoin': {
      name: 'Bitcoin',
      symbol: 'BTC',
      icon: 'bitcoin',
      description: 'La primera y más conocida criptomoneda del mundo.'
    },
    'ethereum': {
      name: 'Ethereum',
      symbol: 'ETH',
      icon: 'circle-dollar-sign',
      description: 'Plataforma descentralizada que permite la creación de contratos inteligentes.'
    },
    'dogecoin': {
      name: 'Dogecoin',
      symbol: 'DOGE',
      icon: 'circle',
      description: 'Criptomoneda basada en el meme del perro Shiba Inu.'
    }
  };
  
  return Object.keys(cryptoTypes).map(id => ({
    params: { id },
    props: { cryptoInfo: cryptoTypes[id] }
  }));
}

// Recibir la información como props
const { cryptoInfo } = Astro.props;
const { id } = Astro.params;

// Obtener datos actuales de la criptomoneda
async function getCryptoData() {
  try {
    const response = await fetch(`https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=${id}&order=market_cap_desc&per_page=1&page=1&sparkline=false&locale=en`);
    const data = await response.json();
    return data[0] || null;
  } catch (error) {
    console.error('Error al obtener datos de criptomoneda:', error);
    return null;
  }
}

const cryptoData = await getCryptoData();

// Valores por defecto si no hay datos
const price = cryptoData?.current_price || 0;
const variation = cryptoData?.price_change_percentage_24h || 0;
const marketCap = cryptoData?.market_cap || 0;
const volume = cryptoData?.total_volume || 0;

// Obtener el valor del dólar oficial para la conversión
async function getDolarOficial() {
  try {
    const response = await fetch('https://dolarapi.com/v1/dolares/oficial');
    const data = await response.json();
    return data.venta || 920;
  } catch (error) {
    return 920; // Valor por defecto
  }
}

const dolarOficial = await getDolarOficial();

const lastUpdate = new Date().toLocaleString('es-AR', { 
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});
---

<Layout title={`${cryptoInfo.name} - Valor Hoy`}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/" class="text-sm flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
        Volver al inicio
      </a>
    </div>
    
    <div class="flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <div class="bg-primary/10 p-3 rounded-full">
          <Icon name={`lucide:${cryptoInfo.icon}`} class="h-6 w-6 text-primary" />
        </div>
        <div>
          <h1 class="text-3xl font-bold">{cryptoInfo.name} <span class="text-muted-foreground font-normal">({cryptoInfo.symbol})</span></h1>
          <p class="text-muted-foreground">{cryptoInfo.description}</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4 bg-card rounded-lg border">
        <div>
          <p class="text-sm text-muted-foreground">Precio USD</p>
          <p class="text-3xl font-bold">
            {new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: 'USD',
              minimumFractionDigits: price < 1 ? 4 : 2,
              maximumFractionDigits: price < 1 ? 4 : 2
            }).format(price)}
          </p>
        </div>
        <div>
          <p class="text-sm text-muted-foreground">Precio ARS</p>
          <p class="text-3xl font-bold">
            {new Intl.NumberFormat('es-AR', {
              style: 'currency',
              currency: 'ARS',
              minimumFractionDigits: 0,
              maximumFractionDigits: 0
            }).format(price * dolarOficial)}
          </p>
        </div>
        <div>
          <p class="text-sm text-muted-foreground">Variación 24h</p>
          <p class={`text-lg font-semibold flex items-center gap-1 ${variation >= 0 ? 'text-green-500' : 'text-red-500'}`}>
            <Icon name={`lucide:${variation >= 0 ? 'arrow-up' : 'arrow-down'}`} class="h-4 w-4" />
            {Math.abs(variation).toFixed(2)}%
          </p>
        </div>
        <div>
          <p class="text-sm text-muted-foreground">Volumen 24h</p>
          <p class="text-lg font-semibold">
            {new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: 'USD',
              notation: 'compact',
              compactDisplay: 'short'
            }).format(volume)}
          </p>
        </div>
      </div>
      
      <div class="text-sm text-muted-foreground text-right">
        Actualizado: {lastUpdate}
      </div>
      
      <div data-type="crypto" data-code={id}>
        <PriceChart 
          title={`Evolución histórica - ${cryptoInfo.name}`}
          type="crypto"
          code={id}
          days={7}
         
        />
      </div>
    </div>
  </main>
</Layout>