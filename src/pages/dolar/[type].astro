---
import Layout from '../../layouts/Layout.astro';
import PriceChart from '../../components/PriceChart.astro';
import { Icon } from 'astro-icon/components';

// Esta función es necesaria para rutas dinámicas en modo estático
export function getStaticPaths() {
  // Definir los tipos de dólar disponibles dentro de getStaticPaths
  const dolarTypes = {
    'blue': {
      name: 'Dólar Blue',
      icon: 'banknote',
      description: 'Cotización del dólar en el mercado informal argentino.'
    },
    'oficial': {
      name: 'Dólar Oficial',
      icon: 'landmark',
      description: 'Cotización oficial del dólar establecida por el Banco Central.'
    },
    'mep': {
      name: 'Dólar MEP',
      icon: 'trending-up',
      description: 'Dólar Bolsa o MEP (Mercado Electrónico de Pagos).'
    },
    'ccl': {
      name: 'Dólar CCL',
      icon: 'bar-chart-2',
      description: 'Dólar Contado con Liquidación para operaciones en el exterior.'
    },
    'tarjeta': {
      name: 'Dólar Tarjeta',
      icon: 'credit-card',
      description: 'Cotización del dólar para compras con tarjeta en el exterior.'
    }
  };
  
  return Object.keys(dolarTypes).map(type => ({
    params: { type },
    props: { dolarInfo: dolarTypes[type] }
  }));
}

// Recibir la información como props
const { dolarInfo } = Astro.props;
const { type } = Astro.params;

// Obtener datos actuales del dólar (similar a index.astro)
async function getDolarData() {
  try {
    const response = await fetch('https://dolarapi.com/v1/dolares');
    const data = await response.json();
    return data.find(d => d.casa === type) || null;
  } catch (error) {
    console.error('Error al obtener datos de dólar:', error);
    return null;
  }
}

const dolarData = await getDolarData();

// Valores por defecto si no hay datos
const buy = dolarData?.compra || 0;
const sell = dolarData?.venta || 0;
const variation = dolarData?.variacion || 0;

const lastUpdate = new Date().toLocaleString('es-AR', { 
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});
---

<Layout title={`${dolarInfo.name} - Valor Hoy`}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/" class="text-sm flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
        Volver al inicio
      </a>
    </div>
    
    <div class="flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <div class="bg-primary/10 p-3 rounded-full">
          <Icon name={`lucide:${dolarInfo.icon}`} class="h-6 w-6 text-primary" />
        </div>
        <div>
          <h1 class="text-3xl font-bold">{dolarInfo.name}</h1>
          <p class="text-muted-foreground">{dolarInfo.description}</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4 bg-card rounded-lg border">
        <div>
          <p class="text-sm text-muted-foreground">Compra</p>
          <p class="text-3xl font-bold">
            {buy ? new Intl.NumberFormat('es-AR', {
              style: 'currency',
              currency: 'ARS',
              maximumFractionDigits: 0
            }).format(buy) : '-'}
          </p>
        </div>
        <div>
          <p class="text-sm text-muted-foreground">Venta</p>
          <p class="text-3xl font-bold">
            {sell ? new Intl.NumberFormat('es-AR', {
              style: 'currency',
              currency: 'ARS',
              maximumFractionDigits: 0
            }).format(sell) : '-'}
          </p>
        </div>
        <div class="col-span-2">
          <p class="text-sm text-muted-foreground">Variación 24h</p>
          <p class={`text-lg font-semibold flex items-center gap-1 ${variation >= 0 ? 'text-green-500' : 'text-red-500'}`}>
            <Icon name={`lucide:${variation >= 0 ? 'arrow-up' : 'arrow-down'}`} class="h-4 w-4" />
            {Math.abs(variation).toFixed(2)}%
          </p>
        </div>
      </div>
      
      <div class="text-sm text-muted-foreground text-right">
        Actualizado: {lastUpdate}
      </div>
      
      <div data-type="dolar" data-code={type}>
        <PriceChart 
          title={`Evolución histórica - ${dolarInfo.name}`}
          type="dolar"
          code={type}
          days={7}
          
        />
      </div>
    </div>
  </main>
</Layout>